      document.getElementById('count-telecom').innerText = rawSituations.filter(s => s.tag === 'telecom').length;
      document.getElementById('count-ssi').innerText = rawSituations.filter(s => s.tag === 'ssi').length;
      document.getElementById('count-ascenseurs').innerText = rawSituations.filter(s => s.tag === 'ascenseurs').length;
    }

    function setFilter(filter) {
      currentFilter = filter;

      document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.classList.remove('bg-emerald-700', 'text-white', 'border-emerald-700');
        btn.classList.add('bg-slate-100', 'text-slate-600', 'border-slate-200');
      });

      const activeBtn = document.getElementById(`filter-${filter}`);
      if (activeBtn) {
        activeBtn.classList.remove('bg-slate-100', 'text-slate-600', 'border-slate-200');
        activeBtn.classList.add('bg-emerald-700', 'text-white', 'border-emerald-700');
      }

      if (filter === 'all') {
        filteredSituations = [...rawSituations];
      } else {
        filteredSituations = rawSituations.filter(item => item.tag === filter);
      }

      currentIndex = -1;
      drawRandomCase();
    }

    function drawRandomCase() {
      if (filteredSituations.length === 0) return;

      let newIndex = Math.floor(Math.random() * filteredSituations.length);
      if (filteredSituations.length > 1 && newIndex === currentIndex) {
        newIndex = (currentIndex + 1) % filteredSituations.length;
      }
      currentIndex = newIndex;

      const item = filteredSituations[currentIndex];

      document.getElementById('card-market').innerText = item.market;
      document.getElementById('card-category-badge').innerText = item.category;
      document.getElementById('card-situation-text').innerText = item.question;

      document.getElementById('answer-posture').innerText = item.posture;
      document.getElementById('answer-proof-text').innerText = item.proof;

      const pointsList = document.getElementById('answer-points');
      pointsList.innerHTML = '';
      item.points.forEach(pt => {
        const li = document.createElement('li');
        li.innerHTML = pt;
        pointsList.appendChild(li);
      });

      document.getElementById('case-counter').innerText = `Cas ${currentIndex + 1} / ${filteredSituations.length}`;
      closeAnswer();
    }

    function toggleAnswer() {
      const drawer = document.getElementById('answer-drawer');
      const isHidden = drawer.classList.contains('hidden');
      if (isHidden) {
        openAnswer();
      } else {
        closeAnswer();
      }
    }

    function openAnswer() {
      document.getElementById('answer-drawer').classList.remove('hidden');
      document.getElementById('toggle-icon').style.transform = 'rotate(180deg)';
      document.getElementById('toggle-label').innerHTML = `<span>🔒</span><span>Masquer l'angle de riposte</span>`;
    }

    function closeAnswer() {
      document.getElementById('answer-drawer').classList.add('hidden');
      document.getElementById('toggle-icon').style.transform = 'rotate(0deg)';
      document.getElementById('toggle-label').innerHTML = `<span>💡</span><span>Voir l'angle de riposte & arguments clés</span>`;
    }

    window.addEventListener('DOMContentLoaded', () => {
      updateBadgeCounts();
      drawRandomCase();
    });
  </script>
