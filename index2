<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mise en Situation</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            cedre: {
              50: '#f0fdf4',
              700: '#15803d',
              800: '#166534',
              900: '#14532d',
              dark: '#0f381e',
              card: '#0f172a', // Style carte foncée comme sur la maquette
            }
          }
        }
      }
    }
  </script>
</head>
<body class="min-h-full flex items-center justify-center p-4 sm:p-6 antialiased font-sans text-slate-800">

  <!-- CARTE D'ENTRAÎNEMENT PRINCIPALE (Format écran unique Ancrage) -->
  <div class="w-full max-w-xl bg-white rounded-3xl shadow-xl shadow-slate-200/80 border border-slate-200/80 p-6 sm:p-8 flex flex-col justify-between transition-all">

    <!-- En-tête : Titre -->
    <div>
      <div class="flex items-center justify-between gap-2 mb-2">
        <div class="flex items-center space-x-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 animate-pulse"></span>
          <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
            Mise en Situation <span class="text-emerald-700">"Ancrage"</span>
          </h1>
        </div>
      </div>

      <p class="text-xs sm:text-sm text-slate-500 leading-relaxed mb-5">
        Générez une question d'objection spontanée pour vous entraîner :
      </p>

      <!-- Filtres rapides par Univers/Marché avec libellés exacts -->
      <div class="flex flex-wrap items-center gap-1.5 mb-4">
        <span class="text-[11px] font-bold text-slate-400 mr-1">Filtre :</span>
        <button onclick="setFilter('all')" id="filter-all" class="filter-btn text-[11px] font-bold px-2.5 py-1 rounded-lg bg-emerald-700 text-white border border-emerald-700 transition">
          Tous (<span id="count-all">0</span>)
        </button>
        <button onclick="setFilter('alim')" id="filter-alim" class="filter-btn text-[11px] font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition">
          Alimentation (<span id="count-alim">0</span>)
        </button>
        <button onclick="setFilter('sdr')" id="filter-sdr" class="filter-btn text-[11px] font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition">
          Sociétés de Restauration (SDR) (<span id="count-sdr">0</span>)
        </button>
        <button onclick="setFilter('med')" id="filter-med" class="filter-btn text-[11px] font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition">
          Dispositifs médicaux (<span id="count-med">0</span>)
        </button>
        <button onclick="setFilter('energie')" id="filter-energie" class="filter-btn text-[11px] font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition">
          EnergiC (<span id="count-energie">0</span>)
        </button>
        <button onclick="setFilter('print')" id="filter-print" class="filter-btn text-[11px] font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition">
          Solutions d'impression (<span id="count-print">0</span>)
        </button>
        <button onclick="setFilter('it')" id="filter-it" class="filter-btn text-[11px] font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition">
          Informatique (<span id="count-it">0</span>)
        </button>
        <button onclick="setFilter('hyg')" id="filter-hyg" class="filter-btn text-[11px] font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition">
          Produits d'entretien (<span id="count-hyg">0</span>)
        </button>
        <button onclick="setFilter('demat')" id="filter-demat" class="filter-btn text-[11px] font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition">
          Solutions de dématarialisation (<span id="count-demat">0</span>)
        </button>
        <button onclick="setFilter('vr')" id="filter-vr" class="filter-btn text-[11px] font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition">
          Vérifications règlementaires (<span id="count-vr">0</span>)
        </button>
        <button onclick="setFilter('sdn')" id="filter-sdn" class="filter-btn text-[11px] font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition">
          Sociétés de Nettoyage (SDN) (<span id="count-sdn">0</span>)
        </button>
        <button onclick="setFilter('telecom')" id="filter-telecom" class="filter-btn text-[11px] font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition">
          Telecom (<span id="count-telecom">0</span>)
        </button>
        <button onclick="setFilter('ssi')" id="filter-ssi" class="filter-btn text-[11px] font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition">
          Systèmes de Sécurité Incendie (SSI) (<span id="count-ssi">0</span>)
        </button>
        <button onclick="setFilter('ascenseurs')" id="filter-ascenseurs" class="filter-btn text-[11px] font-bold px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 transition">
          Ascenseurs (<span id="count-ascenseurs">0</span>)
        </button>
      </div>

      <!-- Bloc Sombre / Carte Situation (Fidèle à l'image fournie) -->
      <div class="bg-[#0b1329] text-white rounded-2xl p-5 sm:p-6 shadow-md relative border border-slate-800 transition-all duration-300">
        <!-- Tag Marché -->
        <div class="flex items-center justify-between text-[11px] font-bold tracking-wider text-sky-400 uppercase mb-3">
          <span id="card-market">MARCHÉ : ALIMENTATION</span>
          <span id="card-category-badge" class="text-[10px] text-slate-400 font-medium lowercase">objection client</span>
        </div>

        <!-- Citation Client en italique -->
        <blockquote id="card-situation-text" class="text-sm sm:text-base font-semibold leading-snug tracking-wide italic text-slate-100">
          « Chargement... »
        </blockquote>
      </div>

      <!-- Tiroir Déroulant : Angle d'attaque & Riposte Terrain -->
      <div class="mt-4">
        <button id="btn-toggle-answer" onclick="toggleAnswer()" class="w-full text-left py-2 px-3 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-xs font-bold text-slate-700 transition flex items-center justify-between">
          <span id="toggle-label" class="flex items-center space-x-1.5">
            <span>💡</span>
            <span>Voir l'angle de riposte & arguments clés</span>
          </span>
          <span id="toggle-icon" class="text-slate-400 transition-transform duration-200">▼</span>
        </button>

        <div id="answer-drawer" class="hidden mt-3 p-4 rounded-2xl bg-emerald-50/70 border border-emerald-200 text-xs text-slate-800 space-y-3">
          <div>
            <span class="font-extrabold uppercase text-[10px] tracking-wider text-emerald-800 bg-emerald-200/60 px-2 py-0.5 rounded">Posture & Réflexe Cèdre</span>
            <p id="answer-posture" class="mt-1 text-slate-700 leading-relaxed font-medium">
              « Parfait, le marché est justement là pour sécuriser ce qui fonctionne déjà ! »
            </p>
          </div>

          <div class="bg-white p-3 rounded-xl border border-emerald-100 shadow-sm space-y-1">
            <span class="font-bold text-emerald-950 block text-[11px]">Arguments massues à sortir :</span>
            <ul id="answer-points" class="list-disc list-inside space-y-1 text-slate-600 text-[11px] leading-relaxed">
              <li>L'AOSM est prise en main de A à Z par nos experts restauration (CDC jusqu'à la signature).</li>
              <li>Si son prestataire est référencé : continuité totale garantie dans un cadre contractuel optimisé (CDI, préavis 3 mois, révision encadrée).</li>
              <li>Proposition immédiate : <em>« Faisons une Étude Économique (EE) gratuite et sans engagement pour situer objectivement vos conditions. »</em></li>
            </ul>
          </div>

          <!-- Chiffre ou preuve terrain -->
          <div id="answer-proof-box" class="p-2.5 rounded-lg bg-emerald-800 text-emerald-50 text-[11px] flex items-start space-x-2">
            <span class="text-amber-300 font-bold flex-shrink-0">⚡ Preuve :</span>
            <span id="answer-proof-text">125 AOSM menés en 2025 avec 100% de satisfaction (NPS). L'assurance d'un vrai suivi.</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bouton Principal : Tirer un autre cas d'objection -->
    <div class="mt-6 pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-3">
      <button onclick="drawRandomCase()" class="w-full sm:w-auto flex-1 inline-flex items-center justify-center space-x-2 px-5 py-3.5 rounded-2xl bg-slate-50 hover:bg-slate-100 active:scale-[0.99] border border-slate-200 text-slate-800 text-sm font-bold shadow-sm hover:shadow transition">
        <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Tirer un autre cas d'objection</span>
      </button>

      <span id="case-counter" class="text-[11px] font-semibold text-slate-400">
        Cas 1 / 12
      </span>
    </div>

    <!-- Petit rappel discret du Slogan Cèdre -->
    <div class="mt-4 text-center">
      <span class="text-[10px] text-slate-400 tracking-wide font-medium">
        le Cèdre • Bâtiment, Restauration, Médical, IT, Hygiène & Énergie • <em>« Recentrez-vous sur l'essentiel »</em>
      </span>
    </div>

  </div>

